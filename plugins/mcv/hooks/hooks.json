{
  "description": "mcv worker hooks. Both do nothing unless MCV_TASK is set, which only an mcv worker has.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${MCV_TASK:-}\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/mcv-status\" --contract"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"${MCV_TASK:-}\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/mcv-status\" --deny-ask"
          }
        ]
      }
    ]
  }
}
