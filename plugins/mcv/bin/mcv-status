#!/usr/bin/env bash
#
# mcv-status: a worker's status log, and the text mcv's hooks give a worker.
#
# A worker (a Claude Code session with MCV_TASK=<project>/<id> set) reports:
#   mcv-status needs-decision <text>   ask the user a question; prints its id (q1, q2, ...)
#   mcv-status blocked <text>          cannot continue
#   mcv-status done <text>             the task is finished
#   mcv-status failed <text>           giving up, with the reason
#   mcv-status note <text>             progress worth knowing; needs no answer
#
# The coordinator records an answer, which closes the question:
#   mcv-status --task <project>/<id> answered <question-id> <text>
#
# mcv's hooks call:
#   mcv-status --contract              SessionStart: the rules a worker follows
#   mcv-status --deny-ask              PreToolUse on AskUserQuestion: refuse it
# Both print nothing and exit 0 unless MCV_TASK names a task that exists.
#
# Each event is one line in ${MCV_HOME:-~/.claude/mcv}/<project>/tasks/<id>/status.log:
#   <UTC time>\t<kind>\t<question id or ->\t<text, tabs and newlines turned into spaces>
#
# Exit: 0 ok; 1 error (bad MCV_TASK or unknown task, unknown or already
# answered question);
# 2 usage (unknown kind, or a worker kind without MCV_TASK).

set -euo pipefail

MCV_HOME="${MCV_HOME:-$HOME/.claude/mcv}"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"

die()   { printf 'mcv-status: %s\n' "$*" >&2; exit 1; }
usage() { printf 'mcv-status: %s\n' "$*" >&2; exit 2; }

TASK_RE='^[a-z][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$'

# True when "<project>/<id>" names a task spawn created (its meta exists).
is_task() {
  [[ "$1" =~ $TASK_RE && -f "$MCV_HOME/${1%%/*}/tasks/${1#*/}/meta" ]]
}

# Turn "<project>/<id>" into its log path; die unless it is a task.
log_of() {
  local task="$1"
  [[ "$task" =~ $TASK_RE ]] || die "expected <project>/<id>, got '$task'"
  is_task "$task" || die "no task '$task' (nothing at $MCV_HOME/${task%%/*}/tasks/${task#*/}/meta)"
  printf '%s/%s/tasks/%s/status.log' "$MCV_HOME" "${task%%/*}" "${task#*/}"
}

# Every write to a log holds its lock, so question numbers never repeat, a
# question is answered once, and long lines never interleave.
#
# The lock holds "<pid> <epoch seconds>". A holder that exits normally
# releases it first, so a lock outliving its pid was left by a crash and is
# taken over. Checking only the pid is not enough: between reading it and
# deleting the lock, that holder can release and another writer take the
# lock, which would then be deleted. So the lock is taken over only if it is
# unchanged since it was read and at least 2 seconds old.
LOCK=""
lock_log() {
  local l="$1.lock" seen pid at now i=0
  until mkdir "$l" 2>/dev/null; do
    seen="$(cat "$l/pid" 2>/dev/null || true)"
    read -r pid at <<<"$seen" || true
    now="$(date +%s)"
    if [[ "$pid" =~ ^[0-9]+$ && "$at" =~ ^[0-9]+$ ]] && (( now - at >= 2 )) \
      && ! kill -0 "$pid" 2>/dev/null \
      && [[ "$(cat "$l/pid" 2>/dev/null || true)" == "$seen" ]]; then
      rm -rf "$l"
      continue
    fi
    (( i++ < 200 )) || die "the status log is locked ($l); delete it if no mcv-status is running"
    sleep 0.05
  done
  LOCK="$l"
  trap 'rm -rf "$LOCK"' EXIT
  printf '%s %s\n' "$$" "$(date +%s)" >"$l/pid"
}

# Append one event as one line.
append() {
  local log="$1" kind="$2" qid="$3" text="$4"
  text="${text//$'\r'/ }"
  text="${text//$'\n'/ }"
  text="${text//$'\t'/ }"
  printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$kind" "$qid" "$text" >>"$log"
}

contract_text() {
  local branch
  branch="$(jq -r '.branch // empty' "$MCV_HOME/${MCV_TASK%%/*}/tasks/${MCV_TASK#*/}/meta" 2>/dev/null || true)"
  if [[ -n "$branch" ]]; then branch="\`$branch\`"; else branch="the branch you started on"; fi
  cat <<EOF
You are an mcv worker for task $MCV_TASK. A coordinator session started you and passes your questions to the user.

Report through mcv-status, by its full path:
  "$SELF" needs-decision "<question>"   when you need the user to choose; it prints the question id
  "$SELF" blocked "<why>"               when you cannot continue
  "$SELF" done "<one-line summary>"     when the task is finished
  "$SELF" failed "<reason>"             when you are giving up
  "$SELF" note "<progress>"             for progress worth knowing that needs no answer

Rules:
- Never use the AskUserQuestion tool. Ask through needs-decision instead. This overrides any skill or instruction that tells you to ask the user.
- After needs-decision, end your turn and wait. The answer arrives as your next prompt.
- Work only in this worktree, your current directory. Never touch the repository's main checkout.
- If the user types into this window directly, that outranks the coordinator. Even then, ask through needs-decision or in plain text, never AskUserQuestion: it is blocked for workers.

Git, always (mcv's floor, whatever else applies):
- Work only on $branch. Never commit to, push to, or merge into any other branch, and never to main, master, develop or a protected branch.
- Never force-push; on your own branch, --force-with-lease only.
- Never commit secrets (.env files, tokens, keys).

Git, everything else: follow this project's own git rules (CLAUDE.md, CONTRIBUTING) where they exist; they win. Where they say nothing:
- Small commits, one change each, in Conventional Commits form ("fix: redirect after login"), imperative, subject at most 72 characters.
- Run the project's tests and linters before committing, if it has them.
- Before handing in, rebase onto the latest base branch.
- Finish by pushing your branch and opening a draft pull or merge request that says what changed, why, and how it was tested; then report done.
EOF
}

case "${1:-}" in
  # A hook acts only for a real worker: MCV_TASK names a task spawn created.
  # Anything else (unset, malformed, a task already removed) is not a worker.
  --contract)
    is_task "${MCV_TASK:-}" || exit 0
    jq -cn --arg ctx "$(contract_text)" \
      '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $ctx}}'
    ;;

  --deny-ask)
    is_task "${MCV_TASK:-}" || exit 0
    reason="mcv workers do not use AskUserQuestion. Ask through: \"$SELF\" needs-decision \"<question>\", then end your turn and wait; the answer arrives as your next prompt."
    jq -cn --arg r "$reason" \
      '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    ;;

  --task)
    [[ $# -eq 5 && "$3" == answered ]] || usage "usage: --task <project>/<id> answered <question-id> <text>"
    log="$(log_of "$2")" || exit 1
    qid="$4"
    [[ "$qid" =~ ^q[1-9][0-9]*$ ]] || die "question id '$qid': expected q1, q2, ..."
    lock_log "$log"
    [[ -f "$log" ]] && cut -f2,3 "$log" | grep -qxF "needs-decision"$'\t'"$qid" \
      || die "no question $qid in task $2"
    ! cut -f2,3 "$log" | grep -qxF "answered"$'\t'"$qid" \
      || die "question $qid in task $2 is already answered"
    append "$log" answered "$qid" "$5"
    ;;

  needs-decision|blocked|done|failed|note)
    [[ -n "${MCV_TASK:-}" ]] || usage "MCV_TASK not set; only an mcv worker reports status"
    [[ $# -ge 2 ]] || usage "usage: $1 <text>"
    log="$(log_of "$MCV_TASK")" || exit 1
    lock_log "$log"
    if [[ "$1" == needs-decision ]]; then
      n=1
      [[ -f "$log" ]] && n=$(( $(cut -f2 "$log" | grep -cx needs-decision || true) + 1 ))
      append "$log" needs-decision "q$n" "$2"
      printf 'q%d\n' "$n"
    else
      append "$log" "$1" - "$2"
    fi
    ;;

  *)
    awk 'NR >= 3 && /^set -euo/ { exit } NR >= 3' "$SELF" | sed 's/^#$//; s/^# //' >&2
    exit 2
    ;;
esac
